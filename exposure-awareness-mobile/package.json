{
  "name": "exposure-awareness-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.23",
    "expo-camera": "~57.0.5",
    "expo-image-picker": "~57.0.19",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "sim": "bash scripts/sim.sh",
    "tz": "bash scripts/tz-matrix.sh",
    "tables": "node scripts/walkthrough-tables.mjs",
    "snapshots": "python3 scripts/snapshot-server.py",
    "web:build": "expo export --platform web"
  },
  "jest": {
    "preset": "jest-expo",
    "maxWorkers": 2,
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ]
  },
  "private": true
}
